; Parallel prime counting. Concurrency in VIBE is by process: fork, do the
; work, hand the result back through a pipe.
;
;   vibec examples/par.vibe -o par && ./par 4

<<"std.vibe"

$$ LIMIT s64 = 400000

@ is_prime (x s64) b {
  ? (x < 2) {
    ^ 0
  }
  ? (x < 4) {
    ^ 1
  }
  ? ((x % 2) == 0) {
    ^ 0
  }
  $~ d s64 = 3
  * ((d * d) <= x) {
    ? ((x % d) == 0) {
      ^ 0
    }
    d = (d + 2)
  }
  ^ 1
}

@ count_range (lo s64, hi s64) s64 {
  $~ n s64 = 0
  $~ i s64 = lo
  * (i < hi) {
    ? is_prime(i) {
      n = (n + 1)
    }
    i = (i + 1)
  }
  ^ n
}

@! () s64 {
  $~ nproc s64 = 4
  ? (argc() > 1) {
    nproc = nat(arg(1))
  }
  ? (nproc < 1) {
    nproc = 1
  }

  $~ fds [2]s32
  ? (pip(&fds[0]) < 0) {
    pe("par: pipe failed\n")
    ^ 1
  }
  $ rfd s64 = s64(fds[0])
  $ wfd s64 = s64(fds[1])

  $ t0 s64 = now_ns()

  $~ k s64 = 0
  * (k < nproc) {
    ? (fork() == 0) {
      $ span s64 = (LIMIT / nproc)
      $ lo s64 = (span * k)
      $~ hi s64 = (span * (k + 1))
      ? (k == (nproc - 1)) {
        hi = LIMIT
      }
      $~ c s64 = count_range(lo, hi)
      wr(wfd, *u8(&c), 8)
      ex(0)
    }
    k = (k + 1)
  }
  fc(wfd)

  $~ total s64 = 0
  $~ got s64 = 0
  * (got < nproc) {
    $~ v s64 = 0
    ? (rd(rfd, *u8(&v), 8) != 8) {
      *<
    }
    total = (total + v)
    got = (got + 1)
  }
  fc(rfd)

  $~ w s64 = 0
  * (w < nproc) {
    waitpid(-1)
    w = (w + 1)
  }

  $ ms s64 = ((now_ns() - t0) / 1000000)
  ps("primes below ")
  pn(LIMIT)
  ps(": ")
  pn(total)
  ps("   across ")
  pn(nproc)
  ps(" processes in ")
  pn(ms)
  ps(" ms\n")
  ^ 0
}
