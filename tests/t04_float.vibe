; out: 3
; out: 314
; out: 1
; exit: 0
<<"std.vibe"

%V3 { x f64, y f64, z f64 }

@ dot (a %V3, b %V3) f64 {
  ^ (((a.x * b.x) + (a.y * b.y)) + (a.z * b.z))
}

@ sqrt (x f64) f64 {
  ? (x <= 0.0) {
    ^ 0.0
  }
  $~ g f64 = x
  $~ i s64 = 0
  * (i < 40) {
    g = (((g + (x / g)) / 2.0))
    i = (i + 1)
  }
  ^ g
}

@! () s64 {
  $ a f64 = 1.5
  $ b f64 = 2.0
  pnl(s64((a * b)))                 ; 3

  $ pi f64 = 3.14159
  pnl(s64((pi * 100.0)))            ; 314

  $ u %V3 = %V3{ x: 1.0, y: 2.0, z: 3.0 }
  $ w %V3 = %V3{ x: 4.0, y: 5.0, z: 6.0 }
  ? (dot(u, w) != 32.0) { ^ 1 }

  ? (sqrt(144.0) < 11.999) { ^ 2 }
  ? (sqrt(144.0) > 12.001) { ^ 3 }

  ; f32 round trip
  $ s f32 = f32(0.5)
  ? (f64(s) != 0.5) { ^ 4 }

  ; int <-> float conversion
  ? (s64(f64(7)) != 7) { ^ 5 }
  ? (f64(3) != 3.0) { ^ 6 }

  pnl(1)
  ^ 0
}
