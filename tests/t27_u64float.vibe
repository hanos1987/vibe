; u64 <-> float conversions above 2^63
; out: 8000000000000000 ffffffffffffffff
; out: 8000000000000000 8000000000000000
; out: 1 1
<<"std.vibe"
<<"math.vibe"

@! () s64 {
  $ m u64 = 18446744073709551615
  $ f f64 = f64(m)
  $ back u64 = u64(f)
  ? f == 18446744073709551616.0 {
    px(back)
    pc(` )
    px(m)
    nl()
  }
  $ h f64 = 9223372036854775808.0
  px(u64(h))
  pc(` )
  px(u64(f32(h)))
  nl()
  $ s u64 = 12345678901234567890
  pn(s64((u64(f64(s)) / 1000000) == (s / 1000000)))
  pc(` )
  pnl(s64(u64(3.99) == u64(3)))
  ^ 0
}
