; VIBE heap library: a real allocator with free, and the three containers
; most programs want. Include it yourself: <<"heap.vibe"
;
;   new del renew            size-class allocator over the arena / mmap
;   %Buf  b*                 growable byte buffer and string builder
;   %Vec<T>  v*              growable array
;   %Map<V>  m*              hash map from %Str to V;  %IMap<V> i*  from s64 to V
<<"std.vibe"

; ---- allocator --------------------------------------------------------------
;
; Every block carries a 16-byte header holding its size class. Freed blocks
; go on a per-class list and are reused first. Requests of 1 MB and over get
; their own mapping, returned to the kernel by del.

$$ HCLASSES s64 = 16
$~ hfree [16]*u8
$~ hlock = 0

@ new (n s64) *u8 {
  $ need s64 = (n + 16)
  $~ k = 0
  $~ sz = 32
  * sz < need {
    sz <<= 1
    k += 1
  }
  ? k >= HCLASSES {
    $ big s64 = ((need + 4095) & -4096)
    $ q *u8 = mm(big)
    ? q == *u8(0) {
      ^ q
    }
    $ qh *s64 = *s64(q)
    qh[0] = -big
    ^ q + 16
  }
  lock(&hlock)
  $~ blk *u8 = hfree[k]
  ? blk != *u8(0) {
    $ nx *s64 = *s64((blk + 16))
    hfree[k] = *u8(nx[0])
  } : {
    blk = alloc(sz)
  }
  unlock(&hlock)
  ? blk == *u8(0) {
    ^ blk
  }
  $ h *s64 = *s64(blk)
  h[0] = k
  ^ blk + 16
}

@ del (p *u8) v {
  ? p == *u8(0) {
    ^
  }
  $ blk *u8 = (p - 16)
  $ h *s64 = *s64(blk)
  $ k s64 = h[0]
  ? k < 0 {
    mu(blk, -k)
    ^
  }
  $ nx *s64 = *s64(p)
  lock(&hlock)
  nx[0] = s64(hfree[k])
  hfree[k] = blk
  unlock(&hlock)
}

; usable bytes in a block returned by new
@ cap_of (p *u8) s64 {
  $ h *s64 = *s64((p - 16))
  $ k s64 = h[0]
  ? k < 0 {
    ^ -k - 16
  }
  ^ (32 << k) - 16
}

; resize, keeping the contents; renew(0, n) is new(n)
@ renew (p *u8, n s64) *u8 {
  ? p == *u8(0) {
    ^ new(n)
  }
  $ have s64 = cap_of(p)
  ? have >= n {
    ^ p
  }
  $ q *u8 = new(n)
  ? q == *u8(0) {
    ^ q
  }
  cp(q, p, have)
  del(p)
  ^ q
}

; ---- byte buffer / string builder ------------------------------------------

%Buf { p *u8, n s64, cap s64 }

@ bnew () %Buf {
  ^ %Buf{ p: *u8(0), n: 0, cap: 0 }
}

@ bfree (b *%Buf) v {
  del(b.p)
  b.p = *u8(0)
  b.n = 0
  b.cap = 0
}

@ bneed (b *%Buf, extra s64) v {
  $ want s64 = ((b.n + extra) + 1)
  ? want <= b.cap {
    ^
  }
  $~ c s64 = (b.cap * 2)
  ? c < want {
    c = want
  }
  ? c < 64 {
    c = 64
  }
  b.p = renew(b.p, c)
  b.cap = c
}

@ bpc (b *%Buf, c u8) v {
  bneed(b, 1)
  b.p[b.n] = c
  b.n += 1
}

@ bpb (b *%Buf, p *u8, n s64) v {
  bneed(b, n)
  cp((b.p + b.n), p, n)
  b.n += n
}

@ bps (b *%Buf, s %Str) v {
  bpb(b, s.p, s.n)
}

@ bpn (b *%Buf, x s64) v {
  $~ t [24]u8
  $~ i = 24
  $~ neg b = (x < 0)
  $~ u u64 = u64(x)
  ? neg {
    u = u64(0) - u
  }
  ? u == u64(0) {
    i -= 1
    t[i] = `0
  }
  * u > u64(0) {
    i -= 1
    t[i] = u8((u % u64(10))) + `0
    u /= u64(10)
  }
  ? neg {
    i -= 1
    t[i] = `-
  }
  bpb(b, &t[i], (24 - i))
}

; append a float rounded to dp decimal places
@ bpf (b *%Buf, x f64, dp s64) v {
  $~ v = x
  ? v < 0.0 {
    bpc(b, `-)
    v = -v
  }
  ? dp <= 0 {
    bpn(b, s64(v + 0.5))
    ^
  }
  $~ scale = 1
  * k 0 dp {
    scale *= 10
  }
  $ scaled = s64((v * f64(scale)) + 0.5)
  bpn(b, scaled / scale)
  bpc(b, `.)
  $ frac = scaled % scale
  $~ d = scale / 10
  * d > 0 {
    bpc(b, u8((frac / d) % 10) + `0)
    d /= 10
  }
}

; append an unsigned decimal
@ bpu (b *%Buf, x u64) v {
  $~ t [24]u8
  $~ i = 24
  $~ u = x
  ? u == 0 {
    i -= 1
    t[i] = `0
  }
  * u > 0 {
    i -= 1
    t[i] = u8(u % 10) + `0
    u /= 10
  }
  bpb(b, &t[i], 24 - i)
}

; append lowercase hex
@ bpx (b *%Buf, x u64) v {
  $~ t [16]u8
  $~ i = 16
  $~ u = x
  ? u == 0 {
    i -= 1
    t[i] = `0
  }
  * u > 0 {
    i -= 1
    $ dgt = u8(u & 15)
    ? dgt < 10 {
      t[i] = dgt + `0
    } : {
      t[i] = (dgt - 10) + `a
    }
    u >>= 4
  }
  bpb(b, &t[i], 16 - i)
}

; the contents as a NUL-terminated %Str; valid until the next append
@ bstr (b *%Buf) %Str {
  bneed(b, 0)
  b.p[b.n] = 0
  ^ %Str{ p: b.p, n: b.n }
}

; ---- growable array ----------------------------------------------------------

%Vec<T> { p *T, n s64, cap s64 }

@ vnew<T> () %Vec<T> {
  ^ %Vec{ p: *T(0), n: 0, cap: 0 }
}

@ vfree<T> (w *%Vec<T>) v {
  del(*u8(w.p))
  w.p = *T(0)
  w.n = 0
  w.cap = 0
}

@ vreserve<T> (w *%Vec<T>, n s64) v {
  ? n <= w.cap {
    ^
  }
  $~ c = w.cap * 2
  ? c < n {
    c = n
  }
  ? c < 8 {
    c = 8
  }
  w.p = *T(renew(*u8(w.p), c * #T))
  w.cap = c
}

@ vpush<T> (w *%Vec<T>, x T) v {
  vreserve(w, w.n + 1)
  w.p[w.n] = x
  w.n += 1
}

@ vpop<T> (w *%Vec<T>) T {
  w.n -= 1
  ^ w.p[w.n]
}

@ vlast<T> (w *%Vec<T>) %Opt<T> {
  ? w.n == 0 {
    ^ %Opt|None
  }
  ^ %Opt|Some(w.p[w.n - 1])
}

; remove element i, keeping the order
@ vdel<T> (w *%Vec<T>, i s64) v {
  * k i (w.n - 1) {
    w.p[k] = w.p[k + 1]
  }
  w.n -= 1
}

; ---- hash maps ------------------------------------------------------------------
;
; %Map<V> maps %Str keys to V; %IMap<V> maps s64 keys to V. Open addressing,
; FNV-1a, grows at 70% load. String keys are not copied: the bytes a key
; points at must outlive its entry.

%Map<V> { keys *%Str, vals *V, st *u8, cap s64, n s64, used s64 }

@ mnew<V> () %Map<V> {
  ^ %Map{ keys: *%Str(0), vals: *V(0), st: *u8(0), cap: 0, n: 0, used: 0 }
}

@ mfree<V> (m *%Map<V>) v {
  del(*u8(m.keys))
  del(*u8(m.vals))
  del(m.st)
  m.cap = 0
  m.n = 0
  m.used = 0
}

@ mhash (s %Str) u64 {
  $~ h u64 = 14695981039346656037
  * i 0 s.n {
    h = (h ^ u64(s.p[i])) * 1099511628211
  }
  ^ h
}

; slot holding k, or -1
@ mfind<V> (m *%Map<V>, k %Str) s64 {
  ? m.cap == 0 {
    ^ -1
  }
  $ mask = m.cap - 1
  $~ i = s64(mhash(k) >> 1) & mask
  * m.st[i] != 0 {
    ? (m.st[i] == 1) && (m.keys[i] == k) {
      ^ i
    }
    i = (i + 1) & mask
  }
  ^ -1
}

@ mgrow<V> (m *%Map<V>) v {
  $ old %Map<V> = m'
  $~ c = old.cap * 2
  ? c < 16 {
    c = 16
  }
  m.keys = *%Str(new(c * #%Str))
  m.vals = *V(new(c * #V))
  m.st = new(c)
  set(m.st, 0, c)
  m.cap = c
  m.n = 0
  m.used = 0
  * i 0 old.cap {
    ? old.st[i] == 1 {
      mset(m, old.keys[i], old.vals[i])
    }
  }
  del(*u8(old.keys))
  del(*u8(old.vals))
  del(old.st)
}

@ mset<V> (m *%Map<V>, k %Str, x V) v {
  $ at = mfind(m, k)
  ? at >= 0 {
    m.vals[at] = x
    ^
  }
  ? ((m.used + 1) * 10) > (m.cap * 7) {
    mgrow(m)
  }
  $ mask = m.cap - 1
  $~ i = s64(mhash(k) >> 1) & mask
  * m.st[i] == 1 {
    i = (i + 1) & mask
  }
  ? m.st[i] == 0 {
    m.used += 1
  }
  m.st[i] = 1
  m.keys[i] = k
  m.vals[i] = x
  m.n += 1
}

@ mhas<V> (m *%Map<V>, k %Str) b {
  ^ mfind(m, k) >= 0
}

; value for k, or dflt when absent
@ mget<V> (m *%Map<V>, k %Str, dflt V) V {
  $ at = mfind(m, k)
  ? at < 0 {
    ^ dflt
  }
  ^ m.vals[at]
}

; address of the value for k, or 0
@ mref<V> (m *%Map<V>, k %Str) *V {
  $ at = mfind(m, k)
  ? at < 0 {
    ^ *V(0)
  }
  ^ &m.vals[at]
}

@ mdel<V> (m *%Map<V>, k %Str) v {
  $ at = mfind(m, k)
  ? at >= 0 {
    m.st[at] = 2
    m.n -= 1
  }
}

; ---- integer-keyed map ------------------------------------------------------------

%IMap<V> { keys *s64, vals *V, st *u8, cap s64, n s64, used s64 }

@ inew<V> () %IMap<V> {
  ^ %IMap{ keys: *s64(0), vals: *V(0), st: *u8(0), cap: 0, n: 0, used: 0 }
}

@ ifree<V> (m *%IMap<V>) v {
  del(*u8(m.keys))
  del(*u8(m.vals))
  del(m.st)
  m.cap = 0
  m.n = 0
  m.used = 0
}

@ ihash (k s64) u64 {
  $~ h = u64(k) * 11400714819323198485
  ^ h ^ (h >> 29)
}

@ ifind<V> (m *%IMap<V>, k s64) s64 {
  ? m.cap == 0 {
    ^ -1
  }
  $ mask = m.cap - 1
  $~ i = s64(ihash(k) >> 1) & mask
  * m.st[i] != 0 {
    ? (m.st[i] == 1) && (m.keys[i] == k) {
      ^ i
    }
    i = (i + 1) & mask
  }
  ^ -1
}

@ igrow<V> (m *%IMap<V>) v {
  $ old %IMap<V> = m'
  $~ c = old.cap * 2
  ? c < 16 {
    c = 16
  }
  m.keys = *s64(new(c * 8))
  m.vals = *V(new(c * #V))
  m.st = new(c)
  set(m.st, 0, c)
  m.cap = c
  m.n = 0
  m.used = 0
  * i 0 old.cap {
    ? old.st[i] == 1 {
      iset(m, old.keys[i], old.vals[i])
    }
  }
  del(*u8(old.keys))
  del(*u8(old.vals))
  del(old.st)
}

@ iset<V> (m *%IMap<V>, k s64, x V) v {
  $ at = ifind(m, k)
  ? at >= 0 {
    m.vals[at] = x
    ^
  }
  ? ((m.used + 1) * 10) > (m.cap * 7) {
    igrow(m)
  }
  $ mask = m.cap - 1
  $~ i = s64(ihash(k) >> 1) & mask
  * m.st[i] == 1 {
    i = (i + 1) & mask
  }
  ? m.st[i] == 0 {
    m.used += 1
  }
  m.st[i] = 1
  m.keys[i] = k
  m.vals[i] = x
  m.n += 1
}

@ ihas<V> (m *%IMap<V>, k s64) b {
  ^ ifind(m, k) >= 0
}

@ iget<V> (m *%IMap<V>, k s64, dflt V) V {
  $ at = ifind(m, k)
  ? at < 0 {
    ^ dflt
  }
  ^ m.vals[at]
}

@ idel<V> (m *%IMap<V>, k s64) v {
  $ at = ifind(m, k)
  ? at >= 0 {
    m.st[at] = 2
    m.n -= 1
  }
}
