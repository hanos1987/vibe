; VIBE standard library, written in VIBE.
; Nothing here is built into the compiler: it is ordinary VIBE talking to the
; kernel through the \N syscall form. No libc.

<<"sys.vibe"

; ---- process ---------------------------------------------------------------

@ ex (c s64) v {
  \231(c)
  ^
}

; ---- raw byte i/o ----------------------------------------------------------

@ wr (fd s64, p *u8, n s64) s64 {
  ^ \1(fd, p, n)
}

@ rd (fd s64, p *u8, n s64) s64 {
  ^ \0(fd, p, n)
}

; ---- text output -----------------------------------------------------------

@ ps (s %Str) v {
  \1(1, s.p, s.n)
  ^
}

@ pe (s %Str) v {
  \1(2, s.p, s.n)
  ^
}

@ pc (c u8) v {
  $~ b u8 = c
  \1(1, &b, 1)
  ^
}

@ nl () v {
  pc(`\n)
  ^
}

; signed decimal
@ pn (x s64) v {
  $~ buf [24]u8
  $~ i s64 = 24
  ; the magnitude as u64, so the most negative value prints too
  $~ u u64 = u64(x)
  ? x < 0 {
    u = u64(0) - u
  }
  ? u == 0 {
    i -= 1
    buf[i] = `0
  }
  * u > 0 {
    i -= 1
    buf[i] = u8(u % 10) + `0
    u = u / 10
  }
  ? x < 0 {
    i -= 1
    buf[i] = `-
  }
  \1(1, &buf[i], 24 - i)
}

; signed decimal followed by a newline
@ pnl (x s64) v {
  pn(x)
  nl()
  ^
}

; lowercase hex, no prefix
@ px (x u64) v {
  $~ buf [16]u8
  $~ i s64 = 16
  $~ v u64 = x
  ? (v == 0) {
    i = (i - 1)
    buf[i] = `0
  }
  * (v > 0) {
    $ d s64 = s64((v & 15))
    i = (i - 1)
    ? (d < 10) {
      buf[i] = u8((`0 + d))
    } : {
      buf[i] = u8((87 + d))
    }
    v = (v >> 4)
  }
  \1(1, &buf[i], (16 - i))
  ^
}

; ---- memory ----------------------------------------------------------------

; anonymous private mapping; returns 0 on failure
@ mm (n s64) *u8 {
  $ r s64 = \9(0, n, 3, 34, -1, 0)
  ? (r < 0) {
    ^ *u8(0)
  }
  ^ *u8(r)
}

@ mu (p *u8, n s64) v {
  \11(p, n)
  ^
}

@ cp (d *u8, s *u8, n s64) v {
  $~ i s64 = 0
  * (i < n) {
    d[i] = s[i]
    i = (i + 1)
  }
  ^
}

@ set (d *u8, c u8, n s64) v {
  $~ i s64 = 0
  * (i < n) {
    d[i] = c
    i = (i + 1)
  }
  ^
}

; ---- bytes and strings -----------------------------------------------------

@ ln (p *u8) s64 {
  $~ i s64 = 0
  * (p[i] != u8(0)) {
    i = (i + 1)
  }
  ^ i
}

@ beq (a *u8, b *u8, n s64) b {
  $~ i s64 = 0
  * (i < n) {
    ? (a[i] != b[i]) {
      ^ 0
    }
    i = (i + 1)
  }
  ^ 1
}

@ seq (a %Str, b %Str) b {
  ? (a.n != b.n) {
    ^ 0
  }
  ^ beq(a.p, b.p, a.n)
}

; ---- integer helpers -------------------------------------------------------

@ abs (x s64) s64 {
  ? (x < 0) {
    ^ -x
  }
  ^ x
}

@ min (a s64, b s64) s64 {
  ? (a < b) {
    ^ a
  }
  ^ b
}

@ max (a s64, b s64) s64 {
  ? (a > b) {
    ^ a
  }
  ^ b
}

; ---- results ----------------------------------------------------------------
; `x!` on a %Res unwraps Ok or returns the Err from the current function;
; on a %Opt it unwraps Some or returns None.

%| Res<T, E> {
  |Ok(T)
  |Err(E)
}

%| Opt<T> {
  |Some(T)
  |None
}

; ---- spin lock ---------------------------------------------------------------
; A lock is an s64 that starts at 0. Short critical sections only.

@ lock (l *s64) v {
  * !\cas(l, 0, 1) {
    \pause()
  }
}

@ unlock (l *s64) v {
  \store(l, 0)
}

; ---- long names ----------------------------------------------------------------
; The two-letter names above are the originals; these read better and cost
; the same once compiled (functions you do not call are not emitted).

@ print (s %Str) v {
  ps(s)
}

@ println (s %Str) v {
  ps(s)
  nl()
}

@ printi (x s64) v {
  pn(x)
}

@ printiln (x s64) v {
  pnl(x)
}

@ eprint (s %Str) v {
  pe(s)
}

@ exit (c s64) v {
  ex(c)
}

@ copy (d *u8, s *u8, n s64) v {
  cp(d, s, n)
}

@ fill (d *u8, c u8, n s64) v {
  set(d, c, n)
}

@ cstrlen (p *u8) s64 {
  ^ ln(p)
}
