; VIBE standard library, written in VIBE.
; Nothing here is built into the compiler: it is ordinary VIBE talking to the
; kernel through the \N syscall form. No libc.

<<"sys.vibe"

; ---- process ---------------------------------------------------------------

@ ex (c s64) v {
  \231(c)
  ^
}

; ---- raw byte i/o ----------------------------------------------------------

@ wr (fd s64, p *u8, n s64) s64 {
  ^ \1(fd, p, n)
}

@ rd (fd s64, p *u8, n s64) s64 {
  ^ \0(fd, p, n)
}

; ---- text output -----------------------------------------------------------

@ ps (s %Str) v {
  \1(1, s.p, s.n)
  ^
}

@ pe (s %Str) v {
  \1(2, s.p, s.n)
  ^
}

@ pc (c u8) v {
  $~ b u8 = c
  \1(1, &b, 1)
  ^
}

@ nl () v {
  pc(`\n)
  ^
}

; signed decimal
@ pn (x s64) v {
  $~ buf [24]u8
  $~ i s64 = 24
  ; the magnitude as u64, so the most negative value prints too
  $~ u u64 = u64(x)
  ? x < 0 {
    u = u64(0) - u
  }
  ? u == 0 {
    i -= 1
    buf[i] = `0
  }
  * u > 0 {
    i -= 1
    buf[i] = u8(u % 10) + `0
    u = u / 10
  }
  ? x < 0 {
    i -= 1
    buf[i] = `-
  }
  \1(1, &buf[i], 24 - i)
}

; signed decimal followed by a newline
@ pnl (x s64) v {
  pn(x)
  nl()
  ^
}

; lowercase hex, no prefix
@ px (x u64) v {
  $~ buf [16]u8
  $~ i s64 = 16
  $~ v u64 = x
  ? (v == 0) {
    i = (i - 1)
    buf[i] = `0
  }
  * (v > 0) {
    $ d s64 = s64((v & 15))
    i = (i - 1)
    ? (d < 10) {
      buf[i] = u8((`0 + d))
    } : {
      buf[i] = u8((87 + d))
    }
    v = (v >> 4)
  }
  \1(1, &buf[i], (16 - i))
  ^
}

; ---- memory ----------------------------------------------------------------

; anonymous private mapping; returns 0 on failure
@ mm (n s64) *u8 {
  $ r s64 = \9(0, n, 3, 34, -1, 0)
  ? (r < 0) {
    ^ *u8(0)
  }
  ^ *u8(r)
}

@ mu (p *u8, n s64) v {
  \11(p, n)
  ^
}

@ cp (d *u8, s *u8, n s64) v {
  $~ i s64 = 0
  * (i < n) {
    d[i] = s[i]
    i = (i + 1)
  }
  ^
}

@ set (d *u8, c u8, n s64) v {
  $~ i s64 = 0
  * (i < n) {
    d[i] = c
    i = (i + 1)
  }
  ^
}

; ---- bytes and strings -----------------------------------------------------

@ ln (p *u8) s64 {
  $~ i s64 = 0
  * (p[i] != u8(0)) {
    i = (i + 1)
  }
  ^ i
}

@ beq (a *u8, b *u8, n s64) b {
  $~ i s64 = 0
  * (i < n) {
    ? (a[i] != b[i]) {
      ^ 0
    }
    i = (i + 1)
  }
  ^ 1
}

@ seq (a %Str, b %Str) b {
  ? (a.n != b.n) {
    ^ 0
  }
  ^ beq(a.p, b.p, a.n)
}

; ---- integer helpers -------------------------------------------------------

@ abs (x s64) s64 {
  ? (x < 0) {
    ^ -x
  }
  ^ x
}

@ min (a s64, b s64) s64 {
  ? (a < b) {
    ^ a
  }
  ^ b
}

@ max (a s64, b s64) s64 {
  ? (a > b) {
    ^ a
  }
  ^ b
}

; ---- results ----------------------------------------------------------------
; `x!` on a %Res unwraps Ok or returns the Err from the current function;
; on a %Opt it unwraps Some or returns None.

%| Res<T, E> {
  |Ok(T)
  |Err(E)
}

%| Opt<T> {
  |Some(T)
  |None
}

; ---- spin lock ---------------------------------------------------------------
; A lock is an s64 that starts at 0. Short critical sections only.

@ lock (l *s64) v {
  * !\cas(l, 0, 1) {
    \pause()
  }
}

@ unlock (l *s64) v {
  \store(l, 0)
}

; ---- long names ----------------------------------------------------------------
; The two-letter names above are the originals; these read better and cost
; the same once compiled (functions you do not call are not emitted).

@ print (s %Str) v {
  ps(s)
}

@ println (s %Str) v {
  ps(s)
  nl()
}

@ printi (x s64) v {
  pn(x)
}

@ printiln (x s64) v {
  pnl(x)
}

@ eprint (s %Str) v {
  pe(s)
}

@ exit (c s64) v {
  ex(c)
}

@ copy (d *u8, s *u8, n s64) v {
  cp(d, s, n)
}

@ fill (d *u8, c u8, n s64) v {
  set(d, c, n)
}

@ cstrlen (p *u8) s64 {
  ^ ln(p)
}

; ---- strings ---------------------------------------------------------------------
; %Str values are views: none of these copy bytes.

; a view of s from byte a up to but not including b
@ ssub (s %Str, a s64, b s64) %Str {
  ? a < 0 {
    a = 0
  }
  ? b > s.n {
    b = s.n
  }
  ? b < a {
    b = a
  }
  ^ %Str{ p: s.p + a, n: b - a }
}

; index of byte c in s, or -1
@ sidx (s %Str, c u8) s64 {
  * i 0 s.n {
    ? s.p[i] == c {
      ^ i
    }
  }
  ^ -1
}

; index of t in s, or -1
@ sfind (s %Str, t %Str) s64 {
  ? t.n == 0 {
    ^ 0
  }
  * i 0 ((s.n - t.n) + 1) {
    ? beq(s.p + i, t.p, t.n) {
      ^ i
    }
  }
  ^ -1
}

@ sstarts (s %Str, t %Str) b {
  ? t.n > s.n {
    ^ 0
  }
  ^ beq(s.p, t.p, t.n)
}

@ sends (s %Str, t %Str) b {
  ? t.n > s.n {
    ^ 0
  }
  ^ beq(s.p + (s.n - t.n), t.p, t.n)
}

@ sspace (c u8) b {
  ^ (c == ` ) || (c == `\t) || (c == `\n) || (c == `\r)
}

; without leading and trailing whitespace
@ strim (s %Str) %Str {
  $~ a = 0
  $~ b = s.n
  * (a < b) && sspace(s.p[a]) {
    a += 1
  }
  * (b > a) && sspace(s.p[b - 1]) {
    b -= 1
  }
  ^ ssub(s, a, b)
}

; the next field of *rest up to sep, advancing *rest past it; sets
; done when the string is exhausted (so "a,b" yields "a", "b", then done)
@ stok (rest *%Str, sep u8, done *b) %Str {
  ? rest.n < 0 {
    done' = 1
    ^ %Str{ p: rest.p, n: 0 }
  }
  $ i = sidx(rest', sep)
  ? i < 0 {
    $ last = rest'
    rest.n = -1
    done' = 0
    ^ last
  }
  $ tok = ssub(rest', 0, i)
  rest.p = rest.p + (i + 1)
  rest.n = rest.n - (i + 1)
  done' = 0
  ^ tok
}

; signed decimal to integer, with an optional leading - ; stops at the
; first non-digit
@ sint (s %Str) s64 {
  $~ i = 0
  $~ neg b = 0
  ? (s.n > 0) && (s.p[0] == `-) {
    neg = 1
    i = 1
  }
  $~ v = 0
  * (i < s.n) && (s.p[i] >= `0) && (s.p[i] <= `9) {
    v = (v * 10) + s64(s.p[i] - `0)
    i += 1
  }
  ? neg {
    ^ -v
  }
  ^ v
}

; decimal with an optional fraction and sign, e.g. "-3.25"
@ sfloat (s %Str) f64 {
  $~ i = 0
  $~ neg b = 0
  ? (s.n > 0) && (s.p[0] == `-) {
    neg = 1
    i = 1
  }
  $~ v = 0.0
  * (i < s.n) && (s.p[i] >= `0) && (s.p[i] <= `9) {
    v = (v * 10.0) + f64(s64(s.p[i] - `0))
    i += 1
  }
  ? (i < s.n) && (s.p[i] == `.) {
    i += 1
    $~ scale = 0.1
    * (i < s.n) && (s.p[i] >= `0) && (s.p[i] <= `9) {
      v += f64(s64(s.p[i] - `0)) * scale
      scale *= 0.1
      i += 1
    }
  }
  ? neg {
    ^ -v
  }
  ^ v
}

; the number of bytes of the UTF-8 character starting with byte c
@ ulen (c u8) s64 {
  ? c < 128 {
    ^ 1
  }
  ? c < 224 {
    ^ 2
  }
  ? c < 240 {
    ^ 3
  }
  ^ 4
}

; count UTF-8 characters
@ uchars (s %Str) s64 {
  $~ i = 0
  $~ n = 0
  * i < s.n {
    i += ulen(s.p[i])
    n += 1
  }
  ^ n
}
