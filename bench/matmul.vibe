; nested loops and array indexing: 300x300 integer matrix multiply
<<"std.vibe"

@! () s64 {
  $ n s64 = 400
  $ sz s64 = ((n * n) * 8)
  $ a *s64 = *s64(mm(sz))
  $ b *s64 = *s64(mm(sz))
  $ c *s64 = *s64(mm(sz))

  $~ i s64 = 0
  * (i < n) {
    $~ j s64 = 0
    * (j < n) {
      a[((i * n) + j)] = ((i + j) % 7)
      b[((i * n) + j)] = ((i - j) % 5)
      j = (j + 1)
    }
    i = (i + 1)
  }

  i = 0
  * (i < n) {
    $~ j s64 = 0
    * (j < n) {
      $~ s s64 = 0
      $~ k s64 = 0
      * (k < n) {
        s = (s + (a[((i * n) + k)] * b[((k * n) + j)]))
        k = (k + 1)
      }
      c[((i * n) + j)] = s
      j = (j + 1)
    }
    i = (i + 1)
  }

  $~ sum s64 = 0
  i = 0
  * (i < (n * n)) {
    sum = (sum + c[i])
    i = (i + 1)
  }
  pnl(sum)
  ^ 0
}
