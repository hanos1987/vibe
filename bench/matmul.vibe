; nested loops and array indexing: 400x400 integer matrix multiply
<<"std.vibe"

@! () s64 {
  $ n = 400
  $ sz = (n * n) * 8
  $ a *s64 = *s64(mm(sz))
  $ b *s64 = *s64(mm(sz))
  $ c *s64 = *s64(mm(sz))

  * i 0 n {
    * j 0 n {
      a[(i * n) + j] = (i + j) % 7
      b[(i * n) + j] = (i - j) % 5
    }
  }

  * i 0 n {
    * j 0 n {
      $~ s = 0
      * k 0 n {
        s += a[(i * n) + k] * b[(k * n) + j]
      }
      c[(i * n) + j] = s
    }
  }

  $~ sum = 0
  * i 0 (n * n) {
    sum += c[i]
  }
  pnl(sum)
  ^ 0
}
