; nested loops and array indexing: 300x300 integer matrix multiply
<<"std.vibe"

@! () s64 {
  $ n = 400
  $ sz s64 = ((n * n) * 8)
  $ a *s64 = *s64(mm(sz))
  $ b *s64 = *s64(mm(sz))
  $ c *s64 = *s64(mm(sz))

  $~ i = 0
  * i < n {
    $~ j = 0
    * j < n {
      a[((i * n) + j)] = ((i + j) % 7)
      b[((i * n) + j)] = ((i - j) % 5)
      j += 1
    }
    i += 1
  }

  i = 0
  * i < n {
    $~ j = 0
    * j < n {
      $~ s = 0
      $~ k = 0
      * k < n {
        s += a[((i * n) + k)] * b[((k * n) + j)]
        k += 1
      }
      c[((i * n) + j)] = s
      j += 1
    }
    i += 1
  }

  $~ sum = 0
  i = 0
  * i < (n * n) {
    sum += c[i]
    i += 1
  }
  pnl(sum)
  ^ 0
}
