; floating point: mandelbrot escape counts over a 900x900 grid
<<"std.vibe"

@! () s64 {
  $ w = 900
  $ h = 900
  $ maxit = 100
  $~ total = 0

  $~ py = 0
  * py < h {
    $~ px = 0
    * px < w {
      $ cr f64 = ((f64(px) / 300.0) - 2.0)
      $ ci f64 = ((f64(py) / 300.0) - 1.5)
      $~ zr = 0.0
      $~ zi = 0.0
      $~ it = 0
      * it < maxit {
        $ zr2 f64 = (zr * zr)
        $ zi2 f64 = (zi * zi)
        ? (zr2 + zi2) > 4.0 {
          *<
        }
        $ t f64 = ((zr2 - zi2) + cr)
        zi = ((2.0 * zr) * zi) + ci
        zr = t
        it += 1
      }
      total += it
      px += 1
    }
    py += 1
  }
  pnl(total)
  ^ 0
}
