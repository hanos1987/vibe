; floating point: 900x900 mandelbrot, 100 iterations
<<"std.vibe"

@! () s64 {
  $ w = 900
  $ h = 900
  $ maxit = 100
  $~ total = 0

  * py 0 h {
    * px 0 w {
      $ cr = (f64(px) / 300.0) - 2.0
      $ ci = (f64(py) / 300.0) - 1.5
      $~ zr = 0.0
      $~ zi = 0.0
      $~ it = 0
      * it < maxit {
        $ zr2 = zr * zr
        $ zi2 = zi * zi
        ? (zr2 + zi2) > 4.0 {
          *<
        }
        $ t = (zr2 - zi2) + cr
        zi = ((2.0 * zr) * zi) + ci
        zr = t
        it += 1
      }
      total += it
    }
  }
  pnl(total)
  ^ 0
}
