; memory-bound: sieve of Eratosthenes to 10,000,000
<<"std.vibe"

@! () s64 {
  $ n s64 = 10000000
  $ p *u8 = mm((n + 1))
  ? (p == *u8(0)) {
    ^ 1
  }
  $~ i s64 = 2
  $~ cnt s64 = 0
  * (i <= n) {
    ? (p[i] == u8(0)) {
      cnt = (cnt + 1)
      $~ j s64 = (i * i)
      * (j <= n) {
        p[j] = 1
        j = (j + i)
      }
    }
    i = (i + 1)
  }
  pnl(cnt)
  ^ 0
}
