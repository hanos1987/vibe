; memory-bound: sieve of Eratosthenes to 10,000,000
<<"std.vibe"

@! () s64 {
  $ n = 10000000
  $ p *u8 = mm(n + 1)
  ? p == *u8(0) {
    ^ 1
  }
  $~ cnt = 0
  * i 2 (n + 1) {
    ? p[i] == 0 {
      cnt += 1
      $~ j = i * i
      * j <= n {
        p[j] = 1
        j += i
      }
    }
  }
  pnl(cnt)
  ^ 0
}
